---
import CardSkills from "./CardSkills.astro";
import TerminalWindow from "./TerminalWindow.astro";
import Claude from "./icons/Claude.astro";
import Java from "./icons/Java.astro";
import JavaScript from "./icons/JavaScript.astro";
import OpenAI from "./icons/OpenAI.astro";
import Python from "./icons/Python.astro";
import Tailwind from "./icons/Tailwind.astro";
import TypeScript from "./icons/TypeScript.astro";
---

<div class="bg-canvas px-4 py-12 sm:px-8 lg:px-12 xl:px-20" id="skills">
    <div class="mx-auto max-w-6xl">
        <TerminalWindow title="~/skills.json" command="cat skills.json --pretty">
            <h2 class="mb-6 text-xl font-bold text-fg sm:text-2xl">
                <span class="text-accent" aria-hidden="true">// </span>Mi enfoque técnico
            </h2>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <CardSkills
                    title="Python"
                    description="Experiencia en el desarrollo de aplicaciones y scripts utilizando Python para diversas tareas, desde automatización hasta análisis de datos."
                >
                    <Python class="h-12 w-12" />
                </CardSkills>
                <CardSkills
                    title="Java"
                    description="Conocimiento en la programación orientada a objetos y desarrollo de aplicaciones utilizando Java."
                >
                    <Java class="h-12 w-12" />
                </CardSkills>
                <CardSkills
                    title="JavaScript && TypeScript"
                    description="Conocimiento en la programación de interactividad y funcionalidades dinámicas con JavaScript y TypeScript."
                >
                    <JavaScript class="h-12 w-12" />
                    <TypeScript class="h-12 w-12" />
                </CardSkills>
                <CardSkills
                    title="Tailwind CSS"
                    description="Experiencia en el desarrollo de aplicaciones web utilizando Tailwind CSS para crear interfaces modernas y responsivas."
                >
                    <Tailwind class="h-12 w-12" />
                </CardSkills>
                <CardSkills
                    title="Claude"
                    description="Uso de Claude como asistente en el desarrollo: revisión y refactorización de código, exploración de tecnologías nuevas y apoyo al aprendizaje."
                >
                    <Claude class="h-12 w-12" />
                </CardSkills>
                <CardSkills
                    title="ChatGPT && OpenAI"
                    description="Uso de ChatGPT para consulta técnica, depuración de errores y contraste de soluciones durante el desarrollo."
                >
                    <OpenAI class="h-12 w-12" />
                </CardSkills>
            </div>
        </TerminalWindow>
    </div>
</div>
