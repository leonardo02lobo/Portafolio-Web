---
import Java from "./icons/Java.astro";
import KaliLinux from "./icons/KaliLinux.astro";
import Python from "./icons/Python.astro";

const hitos = [
    { marca: "🏛️", titulo: "Inicio UNET", año: "2022", tech: null },
    { marca: "👨‍💻", titulo: "Desarrollo full-stack", año: "2024", tech: "java" },
    { marca: "⚙️", titulo: "Enfoque: ciberseguridad & IA", año: "2025", tech: "python" },
    { marca: "🏆", titulo: "Meta: liderazgo técnico", año: null, tech: "kali" },
];
---

<ol class="relative space-y-7 border-l border-line pl-7">
    {
        hitos.map((hito) => (
            <li class="relative">
                <span
                    class="absolute -left-[2.3rem] flex h-8 w-8 items-center justify-center rounded-full border border-accent bg-raised text-sm"
                    aria-hidden="true"
                >
                    {hito.marca}
                </span>

                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="text-sm font-bold text-fg">{hito.titulo}</h3>
                    {hito.año && <span class="text-xs text-accent">{hito.año}</span>}
                </div>

                {hito.tech && (
                    <span class="mt-2 inline-flex items-center gap-2 rounded border border-line px-2.5 py-1 text-xs text-dim">
                        {hito.tech === "java" && <Java class="h-4 w-4" />}
                        {hito.tech === "python" && <Python class="h-4 w-4" />}
                        {hito.tech === "kali" && <KaliLinux class="h-4 w-4" />}
                        <span>
                            {hito.tech === "java" && "Java"}
                            {hito.tech === "python" && "Python"}
                            {hito.tech === "kali" && "Kali Linux"}
                        </span>
                    </span>
                )}
            </li>
        ))
    }
</ol>
