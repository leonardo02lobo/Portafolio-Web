---
import CardProject from "./CardProject.astro";
import TerminalWindow from "./TerminalWindow.astro";
import { getProjects } from "../lib/github/projects";

const { projects, source } = await getProjects("featured");
---

<div class="bg-canvas px-4 py-12 sm:px-8 lg:px-12 xl:px-20">
    <div class="mx-auto max-w-7xl">
        <TerminalWindow id="projects" title="~/proyectos" command="ls ./destacados --collab">
            {
                projects.length > 0 ? (
                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                        {projects.map((project) => (
                            <CardProject project={project} />
                        ))}
                    </div>
                ) : (
                    <p class="text-sm text-warn">
                        <span aria-hidden="true">! </span>
                        No se pudo contactar con GitHub. Reintentando en la próxima visita.
                    </p>
                )
            }

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a
                    href="/projects"
                    class="rounded border border-accent px-5 py-2.5 text-sm font-bold text-accent transition hover:bg-accent hover:text-canvas"
                >
                    <span aria-hidden="true">$</span> ls ./todos
                </a>
                {source !== "api" && (
                    <p class="text-xs text-warn">
                        <span aria-hidden="true">! </span>
                        Mostrando datos en caché: GitHub no respondió.
                    </p>
                )}
            </div>
        </TerminalWindow>
    </div>
</div>
