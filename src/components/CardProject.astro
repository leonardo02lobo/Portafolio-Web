---
import CollaboratorStack from "./CollaboratorStack.astro";
import RepoMeta from "./RepoMeta.astro";
import type { Project } from "../lib/github/types";

interface Props {
    project: Project;
}

const { project } = Astro.props as Props;
---

<article
    class="group flex h-full flex-col gap-4 rounded-md border border-line bg-canvas p-5 transition hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5"
    data-project
    data-name={project.name.toLowerCase()}
    data-description={project.description.toLowerCase()}
    data-languages={project.languages.join("|").toLowerCase()}
>
    <div class="flex items-start gap-3">
        {
            project.imageUrl && (
                <img
                    src={project.imageUrl}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 shrink-0 rounded border border-line object-cover"
                />
            )
        }
        <div class="min-w-0">
            <h3 class="truncate text-base font-bold text-fg sm:text-lg">
                <span class="text-accent" aria-hidden="true">▸ </span>{project.name}
            </h3>
            <p class="truncate text-xs text-dim">{project.fullName}</p>
        </div>
    </div>

    {
        project.description && (
            <p class="text-sm leading-relaxed text-fg/80">{project.description}</p>
        )
    }

    <RepoMeta
        stars={project.stars}
        forks={project.forks}
        language={project.primaryLanguage}
        updatedAt={project.updatedAt}
    />

    {
        project.skills.length > 0 && (
            <ul class="flex flex-wrap gap-2">
                {project.skills.slice(0, 8).map((skill) => (
                    <li class="rounded border border-line px-2 py-0.5 text-xs text-accent-2">
                        --{skill.toLowerCase().replace(/\s+/g, "-")}
                    </li>
                ))}
            </ul>
        )
    }

    <CollaboratorStack collaborators={project.collaborators} />

    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-1">
        <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-accent transition hover:underline"
        >
            <span aria-hidden="true">$</span> ver repo
            <span class="sr-only">de {project.name} en GitHub</span>
        </a>
        {
            project.homepage && (
                <a
                    href={project.homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-medium text-accent-2 transition hover:underline"
                >
                    <span aria-hidden="true">$</span> abrir demo
                    <span class="sr-only">de {project.name}</span>
                </a>
            )
        }
    </div>
</article>
