---
import CardProject from "../components/CardProject.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProjectFilters from "../components/ProjectFilters.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import Layout from "../layouts/Layout.astro";
import { CACHE_CONTROL, getProjects } from "../lib/github/projects";

const { projects, source } = await getProjects("all");

Astro.response.headers.set("Cache-Control", CACHE_CONTROL);

const languages = [...new Set(projects.flatMap((project) => project.languages))].sort(
    (a, b) => a.localeCompare(b),
);
---

<Layout
    title="Proyectos — Leonardo Lobo"
    description="Todos los proyectos públicos de Leonardo Lobo en GitHub: repositorios, tecnologías y colaboradores."
>
    <Header />
    <div class="flex min-h-screen flex-col bg-canvas">

        <main class="flex-grow px-4 py-12 sm:px-8 lg:px-12 xl:px-20">
            <div class="mx-auto max-w-7xl">
                <TerminalWindow title="~/proyectos" command={`ls ./todos --count=${projects.length}`}>
                    <h1 class="mb-6 text-2xl font-bold text-fg sm:text-3xl">
                        <span class="text-accent" aria-hidden="true"># </span>Todos los proyectos
                    </h1>

                    {
                        projects.length > 0 ? (
                            <>
                                <ProjectFilters languages={languages} />
                                <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                                    {projects.map((project) => (
                                        <div>
                                            <CardProject project={project} />
                                        </div>
                                    ))}
                                </div>
                            </>
                        ) : (
                            <p class="py-8 text-sm text-warn">
                                <span aria-hidden="true">! </span>
                                No se pudo contactar con GitHub y no hay datos en caché. Vuelve a
                                intentarlo en unos minutos.
                            </p>
                        )
                    }

                    {
                        source !== "api" && projects.length > 0 && (
                            <p class="mt-6 text-xs text-warn">
                                <span aria-hidden="true">! </span>
                                Datos servidos desde {source === "snapshot" ? "el snapshot local" : "la caché"}:
                                GitHub no respondió a tiempo.
                            </p>
                        )
                    }
                </TerminalWindow>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
